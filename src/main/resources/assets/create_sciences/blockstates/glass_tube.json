{
  "multipart": [
    {
      "apply": {
        "model": "create_sciences:block/glass_tube_core"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "create_sciences:block/glass_tube_connection"
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "create_sciences:block/glass_tube_connection",
        "y": 180
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "create_sciences:block/glass_tube_connection",
        "y": 90
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "create_sciences:block/glass_tube_connection",
        "y": 270
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "create_sciences:block/glass_tube_connection",
        "x": 270
      }
    },
    {
      "when": {
        "down": "true"
      },
      "apply": {
        "model": "create_sciences:block/glass_tube_connection",
        "x": 90
      }
    }
  ]
}
